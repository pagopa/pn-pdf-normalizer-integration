{
  "Parameters": {
    "BeyondocPdfRemediationImageUri": "public.ecr.aws/docker/library/tomcat:9.0.104-jdk21-corretto",
    "BeyondocWorkerImageUri": "public.ecr.aws/docker/library/tomcat:9.0.104-jdk21-corretto",

    "NormalizedPDFHookReservedConcurrency": "1",

    "BeyondocPdfRemediationCpu": "1024",
    "BeyondocPdfRemediationMemory": "2GB",
    "BeyondocWorkerCpu": "1024",
    "BeyondocWorkerMemory": "2GB",

    "RemediationScalingStrategy": "REST-API",
    "BeyondocPdfRemediationMinTasks": "1",
    "BeyondocPdfRemediationMaxTasks": "1",
    "RemediationScalingThresholdRequests": "50",

    "WorkerScalingStrategy": "CUSTOM",
    "BeyondocWorkerMinTasks": "1",
    "BeyondocWorkerMaxTasks": "1",
    "WorkerCpuScalingThreshold": "80",
    "WorkerMemoryScalingThreshold": "80",
    "EcsScalingEvaluationPeriods": "2",

    "BeyondocPdfRemediationDisableOtel": "true",
    "BeyondocWorkerDisableOtel": "true",
    "BeyondocPdfRemediationMountEfs": "false",
    "BeyondocWorkerMountEfs": "false",

    "LambdaAlbPriority": "100",
    "RemediationAlbPriority": "110",

    "EcsMemoryAlarmThreshold": "90"
  }
}