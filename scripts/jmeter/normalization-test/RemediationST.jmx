        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Json Payload Generator">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import groovy.json.JsonOutput

def fileKey = vars.get(&quot;RAND_FILE_KEY&quot;)
if (!fileKey) {
    throw new IllegalArgumentException(&quot;La variabile rand_fileKey non è presente tra le variabili JMeter.&quot;)
}
def body = [
    &quot;fileKey&quot;           : fileKey,
    &quot;transformationType&quot;: &quot;NORMALIZATION&quot;,
    &quot;bucketName&quot;        : vars.get(&quot;BUCKET_NAME&quot;),
    &quot;contentType&quot;       : &quot;application/pdf&quot;
]

def jsonBody = JsonOutput.toJson(body)

log.info(jsonBody)

vars.put(&quot;JSON_PAYLOAD&quot;, jsonBody)
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
