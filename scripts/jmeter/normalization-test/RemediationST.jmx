        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 S3 Sampler">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import software.amazon.awssdk.auth.credentials.ProfileCredentialsProvider
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider
import software.amazon.awssdk.core.sync.RequestBody
import software.amazon.awssdk.regions.Region
import software.amazon.awssdk.services.s3.S3Client
import software.amazon.awssdk.services.s3.model.PutObjectRequest
import software.amazon.awssdk.services.s3.model.PutObjectResponse
import software.amazon.awssdk.services.s3.model.ServerSideEncryption
import software.amazon.awssdk.core.ResponseInputStream
import software.amazon.awssdk.services.s3.model.S3Exception
import org.apache.jmeter.samplers.SampleResult

import java.nio.file.Paths

def bucket = vars.get(&quot;BUCKET_NAME&quot;)
def key = vars.get(&quot;RAND_FILE_KEY&quot;)
def filePath = vars.get(&quot;INPUT_PDF_PATH&quot;)
def region = vars.get(&quot;AWS_REGION&quot;)
def awsProfile = vars.get(&quot;AWS_PROFILE&quot;)
def kmsKeyArn = vars.get(&quot;KMS_KEY_ARN&quot;)

log.info(&quot;Generating sample&quot;)
def sample = new SampleResult()
sample.setSampleLabel(&quot;S3 Upload&quot;)
def thread =  Thread.currentThread().name
log.info(&quot;Executing on thread: $thread&quot; )
sample.sampleStart()


def credentials = awsProfile = null || awsProfile.trim().isEmpty() || (awsProfile ==~ /\d+/) ? DefaultCredentialsProvider.create() : ProfileCredentialsProvider.create(awsProfile)

log.info(&quot;Credentials created: &quot; + credentials.getClass().getName())

def s3 = S3Client.builder()
    .region(Region.of(region))
    .credentialsProvider(credentials)
    .build()

log.info(&quot;[ $thread ] Creating PutRequest.&quot;)

def putRequest = PutObjectRequest.builder()
    .bucket(bucket)
    .key(key)
    .serverSideEncryption(ServerSideEncryption.AWS_KMS)
    .ssekmsKeyId(kmsKeyArn)
    .build()

log.info(&quot;[ $thread ] Readying put request for file &quot; + key)

def putResponse = s3.putObject(putRequest, RequestBody.fromFile(Paths.get(filePath)))
log.info(&quot;[ $thread ] PutObject result: ${putResponse}&quot;)
sample.setSuccessful(true)
sample.setResponseMessage(&quot;Upload completed&quot;)
sample.setResponseCode(&quot;200&quot;)
sample.sampleEnd()
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 SQS Sampler">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import software.amazon.awssdk.auth.credentials.ProfileCredentialsProvider
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider
import software.amazon.awssdk.regions.Region
import software.amazon.awssdk.services.sqs.SqsClient
import software.amazon.awssdk.services.sqs.model.SendMessageRequest
import software.amazon.awssdk.services.sqs.model.SendMessageResponse
import org.apache.jmeter.samplers.SampleResult

def queueUrl = vars.get(&quot;QUEUE_URL&quot;)
def payload = vars.get(&quot;JSON_PAYLOAD&quot;)
def region = vars.get(&quot;AWS_REGION&quot;)
def awsProfile = vars.get(&quot;AWS_PROFILE&quot;)


def sample = new SampleResult()
sample.setSampleLabel(&quot;SQS Send&quot;)
def thread = Thread.currentThread().name
log.info(&quot;Executing SQS send on thread: $thread&quot;)
sample.sampleStart()


log.info(&quot;[ $thread ] Creating SQS client...&quot;)

def credentials = awsProfile = null || awsProfile.trim().isEmpty() || (awsProfile ==~ /\d+/) ? DefaultCredentialsProvider.create() : ProfileCredentialsProvider.create(awsProfile)

log.info(&quot;Credentials created: &quot; + credentials.getClass().getName())

def sqs = SqsClient.builder()
    .region(Region.of(region))
    .credentialsProvider(credentials)
    .build()


log.info(&quot;[ $thread ] Building send message request...&quot;)
def sendRequest = SendMessageRequest.builder()
   .queueUrl(queueUrl)
   .messageBody(payload)
   .build()

log.info(&quot;[ $thread ] Sending message to queue $queueUrl...&quot;)
SendMessageResponse response = sqs.sendMessage(sendRequest)

if (!response.sdkHttpResponse().isSuccessful()) {
   throw new RuntimeException(&quot;SQS sendMessage failed with HTTP ${response.sdkHttpResponse().statusCode()}&quot;)
}
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
