{
  "name": "worker-service-metrics-collector",
  "version": "1.0.0",
  "description": "Lambda function to collect metrics from Beyondoc Worker and publish to CloudWatch",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test-build": "npm run-script test && npm run-script coverage && npm run-script sonar && npm run-script build",
    "build": "rm -f ./function.zip && zip -r ./function.zip . -x './src/test/*' -x '*.md' -x '*.env' -x './coverage/*' -x './.nyc_output/*' -x './.scannerwork/*' -x 'node_modules/@aws-sdk/*'",
    "test": "nyc --reporter=html --reporter=text mocha './src/test/**/*.test.js' --recursive --timeout=5000 --exit -r dotenv/config",
    "coverage": "nyc report --reporter=lcov",
    "sonar": "node sonarqube-scanner.js -Dsonar.login=${SONAR_TOKEN}"
  },
  "keywords": [
    "aws",
    "lambda",
    "ecs",
    "cloudwatch",
    "metrics"
  ],
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "^3.583.0",
    "aws-sdk-client-mock": "^2.2.0",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "mocha": "^10.4.0",
    "nock": "^13.5.4",
    "nyc": "^15.1.0",
    "proxyquire": "^2.1.3",
    "sinon": "^17.0.1",
    "sonarqube-scanner": "^3.5.0"
  }
}